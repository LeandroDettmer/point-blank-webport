{
  "name": "pb-server-ts",
  "private": true,
  "version": "0.0.1",
  "description": "TypeScript port of the PB C# servers (Auth first), same binary protocol and Postgres schema",
  "type": "module",
  "scripts": {
    "auth": "node src/main.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "start": "node src/main.ts",
    "smoke": "node --experimental-transform-types --no-warnings test/smoke.live.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.0",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.3"
  }
}
