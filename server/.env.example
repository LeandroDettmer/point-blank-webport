# Copy this file to server/.env.local (git-ignored) and change what you need.
# Every line is optional: the values below are the defaults. Real environment variables override this file.
# The server reads it at start. The web client needs no env file.

# --- Database (Postgres from db/docker-compose.yml, host port 5433) ---
# Host of Postgres. Default 127.0.0.1.
PB_DB_HOST=127.0.0.1
# Host port of Postgres. Must match the host port Docker publishes (db/docker-compose.yml, PB_DB_PORT there).
PB_DB_PORT=5433
# Database name. Default pb.
PB_DB_NAME=pb
# Database user and password. Defaults postgres / postgres (local only, change them for any shared machine).
PB_DB_USER=postgres
PB_DB_PASS=postgres
# Full connection URL. If set, it replaces the four values above, e.g. postgres://user:pass@host:5432/pb
# PB_DB_URL=
# 1 = use TLS to Postgres (hosted databases). PB_DB_SSL_STRICT=1 also checks the certificate chain.
# PB_DB_SSL=0
# PB_DB_SSL_STRICT=0

# --- Web front (browser on http://localhost:8000 talks to this port) ---
# Port of the web front: /tcp, /signal, /api, /health. Default 8090.
# PB_WEB_PORT=8090

# --- Server list ---
# Public host that the server list sends to clients. Empty = the host stored in the database (127.0.0.1 locally).
# Set it to your LAN or public IP if other machines must connect.
# PB_ADVERTISE_HOST=

# --- P2P battles (optional) ---
# Public STUN is used by default. A TURN relay helps players behind strict NAT. Leave empty to skip it.
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
